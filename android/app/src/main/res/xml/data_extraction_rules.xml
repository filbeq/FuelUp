<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the favourite stations go into the phone's backup and
     device-to-device transfer (an include list leaves out everything else:
     cached price data, settings, the language record). Android 11 and older
     use backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="favorites.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="favorites.xml" />
    </device-transfer>
</data-extraction-rules>
